# Optional: values docker-compose.yml interpolates. Copy to `.env` (next to
# docker-compose.yml) to change them. Application settings — the Gemini key,
# the admin email, and so on — go in backend/.env instead.

# Host port the app is served on: http://localhost:${APP_PORT}
APP_PORT=8080

# Image tag used by `docker compose pull` (latest, or a release like 0.1.0).
JARVIS_VERSION=latest

# Database credentials. Only reachable inside the compose network, but change
# the password for anything beyond your own machine. Changing it after the
# first start needs the volume recreated: `docker compose down -v`.
POSTGRES_USER=jarvis
POSTGRES_PASSWORD=jarvis_dev_password
POSTGRES_DB=jarvis

# docker-compose.dev.yml only: host port for Postgres.
POSTGRES_PORT=5432
