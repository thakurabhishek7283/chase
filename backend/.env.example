DATABASE_URL=postgresql+asyncpg://jarvis:jarvis_dev_password@localhost:5432/jarvis
CORS_ORIGINS=http://localhost:4200

# --- Reasoning LLM (ATS scoring, autofix, LaTeX tailoring) -------------------
# LLM_PROVIDER selects the vendor; ATS_MODEL is the model id *within* it, so the
# two must be changed together. Only the active provider's key is required.
#
#   anthropic + claude-opus-5        (default)
#   google    + gemini-3.5-flash     (also: gemini-2.5-pro, gemini-3.1-pro-preview)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
ATS_MODEL=claude-opus-5
ATS_MAX_AUTOFIX_ITERATIONS=3

# Rate-limit (429) retries. Gemini's free tier allows 5 requests/minute, which a
# single autofix loop can exhaust on its own; retries honour the delay the API
# asks for rather than guessing.
LLM_MAX_RETRIES=3
LLM_RETRY_MAX_WAIT_SECONDS=65

# --- Embeddings -------------------------------------------------------------
# local (key-free, needs the `local-embeddings` extra) | voyage | openai | gemini
# EMBEDDING_DIM must match the pgvector column — changing it needs a migration
# and a full re-index. See ARCHITECTURE.md §6.2.
EMBEDDING_PROVIDER=local
EMBEDDING_DIM=384
# GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# --- Phase 5 — LaTeX resumes. Only needed for PDF output; parsing and tailoring
# work without an engine. Set to an absolute path if tectonic is not on PATH.
LATEX_ENGINE_PATH=tectonic
# Tectonic's first compile downloads packages — raise this if it times out.
LATEX_COMPILE_TIMEOUT_SECONDS=120
