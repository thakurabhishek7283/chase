DATABASE_URL=postgresql+asyncpg://jarvis:jarvis_dev_password@localhost:5432/jarvis
CORS_ORIGINS=http://localhost:4200

# --- Phase 6 — authentication ------------------------------------------------
# JWT signing key. REQUIRED for anything beyond a single dev process: unset
# means a random key per process, so sessions die on restart and never validate
# across workers. Must be at least 32 bytes (RFC 7518 §3.2) — the app refuses a
# shorter one rather than signing weakly. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256

# Access tokens are short-lived because they are not re-checked against the
# database on every request. Refresh tokens live long but are validated against
# users.token_version, so a password change revokes every outstanding session.
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# The account promoted to `admin` when it registers. Explicit rather than
# "first signup wins", which races on a publicly reachable instance. The admin
# clears the company/job moderation queue, so set this before first run.
BOOTSTRAP_ADMIN_EMAIL=

# Length-only password policy: length is what costs an attacker time, while
# composition rules push users toward "Password1!".
MIN_PASSWORD_LENGTH=12

# --- Credential-stuffing guardrails ------------------------------------------
# Failed sign-ins tolerated per window before the endpoint answers 429, counted
# per IP *and* per email address. NOTE: the counter lives in process memory, so
# with N uvicorn workers the real ceiling is roughly N x this. Good enough to
# make online guessing pointless; not a substitute for a shared store if this
# ever runs at scale.
LOGIN_MAX_ATTEMPTS=10
LOGIN_ATTEMPT_WINDOW_SECONDS=300
# Longer than the window on purpose — a limiter that forgives as fast as it
# counts is a speed bump.
LOGIN_LOCKOUT_SECONDS=900
# Signup is unauthenticated and writes a row, so it gets its own ceiling.
REGISTER_MAX_ATTEMPTS=5
REGISTER_ATTEMPT_WINDOW_SECONDS=3600
# Escape hatch for load testing. Never set this false in a deployment.
LOGIN_THROTTLE_ENABLED=true

# Access-Control-Allow-Credentials. Off because auth is a bearer token from
# localStorage — no cross-origin cookie ever needs to ride along, and the
# header only widens what a mistaken CORS_ORIGINS entry can grant.
CORS_ALLOW_CREDENTIALS=false

# --- Reasoning LLM (upload intake, review, patch revision) -------------------
# One of the two providers below is REQUIRED: an upload is not stored until an
# LLM call succeeds, so without one the app cannot be used at all.
# `auto` uses OpenAI when OPENAI_MODEL and OPENAI_API_KEY are both set, Gemini
# otherwise. Force one with google or openai.
LLM_PROVIDER=auto

# Gemini, via the Generative Language API.
# Get a key from https://aistudio.google.com/apikey.
GOOGLE_API_KEY=
# The model id. gemini-3.5-flash is the cheapest that handles these prompts
# well; gemini-2.5-pro and gemini-3.1-pro-preview also work.
ATS_MODEL=gemini-3.5-flash

# OpenAI-compatible endpoint over the Responses API: OpenAI, or Azure OpenAI.
# On Azure, OPENAI_MODEL is the deployment name and the base URL ends in
# /openai/v1. Leave OPENAI_BASE_URL unset for api.openai.com.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
# 1/true = medium effort; minimal | low | medium | high; 0 or empty = none.
OPENAI_REASONING=

# Rate-limit (429) retries. Gemini's free tier allows 5 requests/minute AND 20
# per day; retries honour the delay the API asks for rather than guessing, but
# nothing can wait out the daily cap.
LLM_MAX_RETRIES=3
LLM_RETRY_MAX_WAIT_SECONDS=65

# --- Embeddings -------------------------------------------------------------
# Semantic matching embeds on this machine (fastembed/ONNX, needs the
# `local-embeddings` extra) — no key, no per-call cost, nothing sent anywhere.
# EMBEDDING_DIM must match both LOCAL_EMBEDDING_MODEL's width and the pgvector
# column; changing it needs a migration and a full re-index. See
# ARCHITECTURE.md §8.1.
EMBEDDING_DIM=384
# LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- LaTeX. Required: an upload is not stored until the engine compiles it.
# Every engine (pdflatex, xelatex, lualatex, latexmk) runs inside a
# separate worker service this app only ever talks HTTP to — build the image
# once with `docker build -t jarvis-latex:latest latex-worker`, then
# either run it standalone (`docker run -d -p 8100:8100 jarvis-latex:latest`)
# for native development, or let docker-compose.yml run it as the
# `latex-worker` service (which also points LATEX_WORKER_URL at it for you).
LATEX_DEFAULT_ENGINE=pdflatex
LATEX_WORKER_URL=http://localhost:8100
# Raise this if a large or unusual document times out mid-compile.
LATEX_COMPILE_TIMEOUT_SECONDS=120

# When a .tex uses macros the built-in shapes cannot read, ask the model what
# they mean rather than sending the author off to hand-annotate their file.
# Costs one LLM call per such upload, and only for uploads that would otherwise
# be rejected. Set false to keep every upload deterministic and free.
# A resume is mostly template. A proposed config claiming more of the body than
# this has lost the frozen/editable boundary rather than found it, and is
# refused. See ARCHITECTURE.md §8A.4.
LATEX_MAX_EDITABLE_FRACTION=0.6
# Ceiling on how much of a .tex is shown to the discovery model.
LATEX_DISCOVERY_MAX_CHARS=24000
